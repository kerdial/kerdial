# Kerdial — deployment configuration.
#
# Copy this file to `.env` in the same folder as `docker-compose.yml`
# (`cp .env.example .env`) and fill in the four empty passwords below; the
# README's "Quick start" has a command that generates them. `docker compose`
# reads `.env` from the folder the compose file lives in. Keep `.env` private:
# it holds every password of your installation. Never commit or share it.
#
# Every setting is explained in docs/deploy-runbook.md: bring-up in
# docs/deploy-runbook.md §0, the exposure settings at the bottom of this file
# in docs/deploy-runbook.md §1.

# --- Images ---------------------------------------------------------------
# Published to Docker Hub, `linux/amd64` only, by the **release workflow alone**
# — a pull request and a merge to `main` build nothing and publish nothing.
# `latest` is the newest release; pin `X.Y.Z` (for example `0.2.0`) for a
# deployment that only moves when you change this line.
APP_IMAGE=docker.io/kerdial/kerdial:latest

# --- Database -------------------------------------------------------------
# The Postgres superuser is the *bootstrap* identity: it initialises the volume
# and runs the one-shot `migrate` service. The application never connects as it —
# `api` connects as `app_web` and `worker` as `app_ingest`, both created by
# migration `0007` and given the passwords below by the `migrate` step.
#
# Generate each of these once, with something like `openssl rand -hex 24`, and
# keep them. Changing APP_WEB_PASSWORD/APP_INGEST_PASSWORD is
# safe (the next `migrate` run re-applies them); changing
# POSTGRES_SUPERUSER_PASSWORD after the volume is initialised is NOT — the volume
# already holds the old one.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
# The database the stack creates on a fresh volume. An install upgraded from
# 0.1.x restores its dump into this database — docs/deploy-runbook.md,
# "Upgrading from 0.1.x".
POSTGRES_DB=kerdial
APP_WEB_PASSWORD=
APP_INGEST_PASSWORD=

# --- Application ----------------------------------------------------------
# The server secret the CSRF token is HMAC'd against. Must be stable across
# restarts: a fresh value silently invalidates the csrf_token cookie of every
# already-logged-in browser while the session cookie keeps validating, so saves
# fail with "CSRF token missing or invalid" until the user logs out and back in.
CSRF_SECRET=

# Optional. The one-time token `POST /auth/setup` requires, i.e.
# the fourth field of the first-run setup screen. Leave it BLANK for the normal
# case: the api then generates one per start-up and prints it, once, while the
# instance is still unclaimed —
#
#   docker compose logs api | grep 'setup token'
#
# Set it only to claim a stack from a script, or from a host that cannot read
# the api's log. Blank is treated as unset, not as an empty token. It buys
# nothing once the instance is claimed: the api stops printing it and the route
# answers 409 to everyone. If you set one for scripted
# bring-up: at least 16 characters (the api refuses to boot below that), use a
# throwaway value — whatever is set here is also printed in the api log — and
# unset it once the instance is claimed.
SETUP_TOKEN=

# Whether the session and CSRF cookies carry the `Secure` attribute.
# Leave it at `true` (or unset) whenever the port is reachable through a TLS
# proxy or from anywhere you do not fully control. Set it to `false` ONLY when
# nothing but this LAN can reach the port and you use plain http:// — a browser
# will not store a `Secure` cookie over http, so log-in cannot work otherwise.
# Any value other than `true`/`false` refuses to boot.
COOKIE_SECURE=true

# --- Exposure (docs/deploy-runbook.md §1) ---------------------------------
# The app just exposes the api on a port (API_BIND below) — a reverse proxy is
# never required and never assumed; TLS, domain and nginx/Caddy/Traefik in
# front of that port are entirely your call, outside this stack.
#
# TRUST_PROXY is a SEPARATE knob and does not affect exposure at all. This file
# ships the first row below (a proxy on this machine: API_BIND=127.0.0.1,
# TRUST_PROXY=1). With no proxy in front, blank it — the only effect of leaving
# it blank behind a proxy is that the login-throttle then treats every client
# behind that proxy as one shared address (see docs/deploy-runbook.md §1).
# Two plain knobs. Pick the row that describes your setup:
#
#   proxy on this machine (Caddy/nginx on the NAS)  API_BIND=127.0.0.1  TRUST_PROXY=1
#   no proxy, LAN only, plain http                 API_BIND=0.0.0.0    TRUST_PROXY=   (and COOKIE_SECURE=false)
#   proxy on another machine                       API_BIND=0.0.0.0    TRUST_PROXY=<that machine's address>
#
# API_BIND is the interface the port is published on; 127.0.0.1 means nothing
# off this host can reach the api. TRUST_PROXY is what makes the per-IP login
# throttle see the real client behind a proxy: a hop count, or the proxy's own
# address/CIDR — never `true`, which would let any client choose its own
# address. Blank means trust nothing.
#
# Behind a proxy with TRUST_PROXY blank, every client arrives as the proxy's own
# address, so they share ONE login-backoff history and ONE sign-in concurrency
# bucket of 2: one device with two sign-ins in flight answers everyone
# else 429 until it finishes. Runbook section 1 has the detail.
API_BIND=127.0.0.1
API_PORT=3000
TRUST_PROXY=1

# --- Slow hardware (docs/deploy-runbook.md §5) ----------------------------
# How long one request may run, in milliseconds. Default 30000. Leave it blank
# unless an import comes back with rows marked
# "Cette ligne n'a pas été traitée : le temps imparti à l'import était écoulé."
# On a NAS, 120000 is a reasonable first move.
#
# The import's own apply deadline is derived from this — it is always 5000 ms
# below it — so this is the only variable to change. There is a separate
# IMPORT_APPLY_DEADLINE_MS for pinning it lower, and IMPORT_APPLY_CHUNK_ROWS
# (default 50) for how many rows share one write transaction; neither is
# normally needed. An out-of-range value refuses to boot rather than being
# silently clamped. Blank is unset, not zero.
HTTP_TIMEOUT_MS=

# --- Backups --------------------------------------------------------------
# Nothing to configure: Kerdial does not back itself up. Keep a copy of your
# data either from the app (the « Importer » screen exports everything to two
# files you can import back) or as a database dump, taken by hand as the
# Postgres superuser — docs/deploy-runbook.md, "3. Taking a copy of the
# database, and restoring one — by hand". Both are unencrypted: store them
# somewhere safe.
