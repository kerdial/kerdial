# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
.turbo/

# Web (Vite)
web/dist/
web/.vite/
# vite-plugin-pwa's dev-mode service worker output (`devOptions.enabled`,
