web/dev-dist/

# Env / secrets — never commit
.env
.env.*
!.env.example
# `deploy/env` — never committed.
deploy/env
*.pem
*.key

# Test / tooling artefacts
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
web/e2e/.cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local scratch (never committed)
/scratch/

# Local Portfolio Performance exports used for manual testing — never committed.
/docs/samples/

# Design bundle (design system + mockups) — local reference, never committed
/.design/

# Local tooling and private working files — never committed
CLAUDE.md
.claude/
cleanup.md
.dev-logs/
